# ========== DC 量化跟单系统 环境变量 ==========
# 复制为 .env 后填写真实值。生产环境务必使用强随机密钥。

# ---- 应用 ----
APP_ENV=production            # development | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_NAME=DC量化跟单系统

# ---- 安全密钥 ----
# 生成: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-strong-random-secret
# Fernet 密钥(加密交易所 API Key): python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-to-a-fernet-key
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=1440       # 24h

# ---- 数据库 ----
POSTGRES_USER=dcquant
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=dcquant
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://dcquant:change-me-strong-password@postgres:5432/dcquant

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- Discord ----
# 用户 TOKEN(self-bot,仅监听已加入的付费 KOL 群;违反 Discord ToS,风险自担)
DISCORD_TOKEN=
# 监听心跳间隔(秒)
DISCORD_HEARTBEAT_INTERVAL=41

# ---- OCR ----
# 是否启用图片 OCR 识别策略
OCR_ENABLED=true
TESSERACT_CMD=tesseract

# ---- 管理员初始化 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-admin-password

# ---- 前端 ----
FRONTEND_PORT=5173
VITE_API_BASE=http://localhost:8000/api
VITE_WS_BASE=ws://localhost:8000/ws

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
