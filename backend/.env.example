# ==================== DC 量化跟单系统环境配置 ====================
# 复制此文件为 .env 并填入实际值

# ==================== 应用配置 ====================
APP_ENV=development  # development 或 production
APP_HOST=0.0.0.0
APP_PORT=8000

# ==================== 安全配置 ====================
JWT_SECRET=change-me-to-a-secure-key
JWT_ALG=HS256
JWT_EXPIRE_MINUTES=1440  # 24小时
FERNET_KEY=change-me-to-a-fernet-key

# ==================== 数据库配置 ====================
DATABASE_URL=postgresql+asyncpg://dcquant:dcquant@localhost:5432/dcquant

# ==================== Redis 配置 ====================
REDIS_URL=redis://localhost:6379/0

# ==================== Discord 配置 ====================
DISCORD_TOKEN=your-discord-bot-token
DISCORD_HEARTBEAT_INTERVAL=41

# ==================== OCR 配置 ====================
OCR_ENABLED=true
TESSERACT_CMD=tesseract

# ==================== LLM 配置 (双 LLM 架构) ====================
# 双 LLM: 文本走 DeepSeek V3, 图片走 GLM-4V
# 运行时也可在管理后台「系统设置」修改,数据库配置优先级高于 .env

# 全局开关 (关闭后两个模型都不调用)
LLM_ENABLED=false

# ---- 文本 LLM (DeepSeek V3,解析信号文本) ----
LLM_PROVIDER=deepseek
LLM_API_KEY=your-deepseek-api-key
LLM_API_BASE=  # 留空用默认: https://api.deepseek.com/v1
LLM_MODEL=  # 留空用默认: deepseek-chat
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
LLM_TIMEOUT=30

# ---- 图片 LLM (GLM-4V,解析图片信号,仅对勾选的 KOL 生效) ----
# 留空则回退到文本 LLM 的 Key(若同提供商)或 zhipu 默认值
VISION_LLM_ENABLED=false
VISION_LLM_PROVIDER=zhipu
VISION_LLM_API_KEY=  # 留空则复用文本 LLM 的 Key
VISION_LLM_API_BASE=  # 留空用默认: https://open.bigmodel.cn/api/paas/v4
VISION_LLM_MODEL=  # 留空用默认: glm-4v
VISION_LLM_TEMPERATURE=0.1
VISION_LLM_MAX_TOKENS=2000
VISION_LLM_TIMEOUT=60

# ==================== 管理员配置 ====================
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ==================== CORS 配置 ====================
CORS_ORIGINS=http://localhost:5173,http://localhost:3000